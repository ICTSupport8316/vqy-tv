# Optioneel. Zonder .env werkt alles met de standaardwaarden hieronder.
# Op de server: C:\HallTV\.env (wordt bij een deploy niet overschreven).

# Webserver. De firewallregel "VQY Hal-TV" wordt bij de volgende deploy vanzelf aangepast.
PORT=8800

# Map voor slides, foto's en het wachtwoord. Leeg = data\ naast server.js
DATA_DIR=
